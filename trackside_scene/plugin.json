    {
      "name": "period",
      "type": "select",
      "label": "When",
      "default": "now",
      "choices": [
        {
          "value": "now",
          "label": "What is within reach now"
        },
        {
          "value": "since",
          "label": "Everything that passed since the last render"
        }
      ],
      "help": "Since the last render keeps a watch on the place between renders (the feeds asked every minute) and shows every train and tram seen since the page was last drawn for a panel, each at her closest approach with the time. The editor's previews show the same window without moving it on; the watch stops three hours after a page last asked, and a first render shows the last hour.",
      "advanced": true
    },
    {
      "name": "paint",
      "type": "select",
      "label": "Paint",
      "default": "all",
      "choices": [
        {
          "value": "all",
          "label": "Every vehicle with a photograph, her own or her class's"
        },
        {
          "value": "own",
          "label": "Only vehicles with a photograph of their own"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "A painting from a photograph of her class keeps the class's shape and the operator's standard livery but not her own wrap or number, and is marked an impression. Only vehicles with a photograph of their own asks for no such painting; the rest show as the setting below says.",
      "advanced": true
    },
    {
      "name": "fidelity",
      "type": "select",
      "label": "Faithfulness",
      "default": "photo",
      "choices": [
        {
          "value": "photo",
          "label": "As photographed: the same angle, every mark of the livery"
        },
        {
          "value": "side",
          "label": "Side-on, from both pictures: her livery from her photograph, her length and doors from her class's side view"
        },
        {
          "value": "free",
          "label": "Drawn afresh: the model's own composition, the view below"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "Most photographs of a tram or a train are taken from the front three-quarter. Side-on hands the painter a second picture of her class seen from the side (chosen by hand for each Melbourne class, or your own under the Trackside Core settings) and paints a pure side elevation, the way a fleet line-up reads; a class without a side view is painted side-on from her photograph alone. The other two use the side view too, where there is one, for her length and the spacing of her doors.",
      "advanced": true
    },
    {
      "name": "view",
      "type": "select",
      "label": "View",
      "default": "side",
      "choices": [
        {
          "value": "side",
          "label": "From the side, a little to the front"
        },
        {
          "value": "profile",
          "label": "Side-on: a pure profile, as a builder's drawing"
        },
        {
          "value": "quarter",
          "label": "From the front three-quarter, coming on"
        },
        {
          "value": "head",
          "label": "Head-on"
        }
      ],
      "show_if": {
        "pictures": "paintings",
        "fidelity": "free"
      },
      "advanced": true
    },
    {
      "name": "model",
      "type": "select",
      "label": "Model",
      "default": "nano_banana",
      "choices": [
        {
          "value": "nano_banana",
          "label": "Nano Banana (about US$0.04)"
        },
        {
          "value": "nano_banana_pro",
          "label": "Nano Banana Pro (about US$0.15)"
        },
        {
          "value": "flux_kontext",
          "label": "FLUX.1 Kontext Pro (about US$0.04)"
        },
        {
          "value": "gpt_image",
          "label": "GPT Image 2 (about US$0.05)"
        },
        {
          "value": "seedream",
