    {
      "name": "custom_style",
      "type": "textarea",
      "label": "Your own prompt",
      "default": "",
      "show_if": {
        "pictures": "paintings",
        "style": "custom"
      },
      "presets": [
        {
          "label": "Gouache poster",
          "value": "a vintage railway poster in gouache: flat confident shapes, a warm limited palette, crisp edges"
        },
        {
          "label": "Cutaway",
          "value": "a 1950s magazine cutaway illustration: the body opened to show the seats and the driver's cab, labelled in small neat capitals"
        },
        {
          "label": "Chalk pastel",
          "value": "a chalk pastel drawing on grey paper, soft and smudgy, with the sun catching the side of the tram"
        },
        {
          "label": "Railway art",
          "value": "a traditional oil painting in the manner of classic railway art: dramatic light, polished steel, confident brushwork"
        },
        {
          "label": "Comic ink",
          "value": "a comic-book ink drawing with bold outlines, hatched shadows and flat halftone colour"
        },
        {
          "label": "Neon line",
          "value": "a single-weight neon line drawing on white: one continuous glowing line describing the tram"
        }
      ],
      "help": "The medium and the look; the widget adds the vehicle, her photograph and the paper. Pick an example above to start from."
    },
