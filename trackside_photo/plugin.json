{
  "tesserae_compat": "1.x",
  "name": "Trackside: Photo",
  "version": "0.5.1",
  "kind": "widget",
  "tesserae_min": "0.463.0",
  "description": "The nearest train or tram to a place, right now, as a full-bleed photograph of the very vehicle or her class (Wikimedia Commons), with her number, class, line and distance, and the next few along a strip. Melbourne with a free key, or any agency's GTFS-Realtime feed.",
  "icon": "ph-train",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*",
    "settings:plugin/trackside_core",
    "plugin:trackside_core"
  ],
  "render": {
    "needs_network": true,
    "warm_ahead_s": 150
  },
  "design": {
    "palette": "extended"
  },
  "cell_options": [
    {
      "name": "source",
      "type": "select",
      "label": "Positions from",
      "default": "melbourne",
      "choices": [
        {
          "value": "ptv",
          "label": "Melbourne: PTV Timetable API (developer id and key): trains live with their destination, trams due at the stops near you"
        },
        {
          "value": "melbourne",
          "label": "Melbourne: whichever key is in the settings (Transport Victoria open data, else the PTV Timetable API)"
        },
        {
          "value": "boston",
          "label": "Boston: MBTA subway, light rail and commuter rail (no key)"
        },
        {
          "value": "brisbane",
          "label": "Brisbane: Queensland Rail City network (Translink, no key)"
        },
        {
          "value": "goldcoast",
          "label": "Gold Coast: G:link light rail (Translink, no key)"
        },
        {
          "value": "custom",
          "label": "Another agency's GTFS-Realtime feed"
        }
      ],
      "help": "Melbourne two ways. The PTV Timetable API (a developer id and key from PTV) gives every Metro train's live position, cars and destination, and each tram by fleet number at the stop it is due at next, with the minutes to go; it has no live V/Line. Transport Victoria's open data (a different, free key) gives every train and tram's live position but no destinations. The others need no key. Another agency: most publish their vehicle positions as GTFS-Realtime; give the feed's link below."
    },
    {
      "name": "feed_urls",
      "type": "textarea",
      "label": "Vehicle positions feeds",
      "default": "",
      "show_if": {
        "source": "custom"
      },
      "help": "One GTFS-Realtime VehiclePositions link a line, up to four (the agency's open data page names them)."
    },
    {
      "name": "key_header",
      "type": "string",
      "label": "Key header",
      "default": "",
      "show_if": {
        "source": "custom"
      },
      "help": "The HTTP header the agency wants its key in, for example x-api-key or Authorization. Blank for a feed without a key."
    },
    {
      "name": "feed_key",
      "type": "string",
      "label": "Key",
      "default": "",
      "secret": true,
      "show_if": {
        "source": "custom"
      }
    },
    {
      "name": "operator",
      "type": "string",
      "label": "Operator, for the photographs",
      "default": "",
      "show_if": {
        "source": "custom"
      },
      "help": "The name Wikimedia Commons knows the operator by (for example Sydney Trains); the widget looks for a photograph of each vehicle by this and her number."
    },
    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "The point the distances and bearings are from. Falls back to the app's location."
    },
    {
      "name": "radius_km",
      "type": "select",
      "label": "Within",
      "default": "3",
      "choices": [
        {
          "value": "1",
          "label": "1 km"
        },
        {
          "value": "2",
          "label": "2 km"
        },
        {
          "value": "3",
          "label": "3 km"
        },
        {
          "value": "5",
          "label": "5 km"
        },
        {
          "value": "10",
          "label": "10 km"
        },
        {
          "value": "15",
          "label": "15 km"
        },
        {
          "value": "25",
          "label": "25 km"
        }
      ]
    },
    {
      "name": "strip",
      "type": "number",
      "label": "How many along the strip",
      "default": 4,
      "help": "0 to 8 after the nearest."
    },
    {
      "name": "paper",
      "type": "select",
      "label": "Paper",
      "default": "cream",
      "choices": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "aged",
          "label": "Aged"
        },
        {
          "value": "blueprint",
          "label": "Blueprint: pale ink on blue"
        },
        {
          "value": "sky",
          "label": "A soft sky wash"
        }
      ]
    },
    {
      "name": "modes",
      "type": "multiselect",
      "label": "Show",
      "default": [
        "tram",
        "train",
        "regional",
        "subway"
      ],
      "choices": [
        {
          "value": "tram",
          "label": "Trams and light rail"
        },
        {
          "value": "train",
          "label": "Suburban trains"
        },
        {
          "value": "regional",
          "label": "Regional trains"
        },
        {
          "value": "subway",
          "label": "Subway and metro"
        }
      ],
      "advanced": true
    },
    {
      "name": "order",
      "type": "select",
      "label": "Order",
      "default": "nearest",
      "choices": [
        {
          "value": "nearest",
          "label": "Nearest first"
        },
        {
          "value": "fastest",
          "label": "Fastest first"
        },
        {
          "value": "longest",
          "label": "Longest first"
        }
      ],
      "advanced": true
    },
    {
      "name": "period",
      "type": "select",
      "label": "When",
      "default": "now",
      "choices": [
        {
          "value": "now",
          "label": "What is within reach now"
        },
        {
          "value": "since",
          "label": "Everything that passed since the last render"
        }
      ],
      "help": "Since the last render keeps a watch on the place between renders (the feeds asked every minute) and shows every train and tram seen since the page was last drawn for a panel, each at her closest approach with the time. The editor's previews show the same window without moving it on; the watch stops three hours after a page last asked, and a first render shows the last hour.",
      "advanced": true
    },
    {
      "name": "photo_fit",
      "type": "select",
      "label": "Photograph fit",
      "default": "cover",
      "choices": [
        {
          "value": "cover",
          "label": "Fills the page"
        },
        {
          "value": "contain",
          "label": "Fits inside the page"
        }
      ],
      "advanced": true
    },
    {
      "name": "labels",
      "type": "multiselect",
      "label": "Label lines",
      "default": [
        "line",
        "speed",
        "distance"
      ],
      "help": "In this order, under or beside each vehicle.",
      "choices": [
        {
          "value": "type",
          "label": "Class"
        },
        {
          "value": "line",
          "label": "Line or route"
        },
        {
          "value": "dest",
          "label": "Where she is going"
        },
        {
          "value": "number",
          "label": "Fleet number"
        },
        {
          "value": "operator",
          "label": "Operator"
        },
        {
          "value": "status",
          "label": "At a stop or between"
        },
        {
          "value": "speed",
          "label": "Speed"
        },
        {
          "value": "distance",
          "label": "Distance and bearing"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "seen",
          "label": "When she was within reach"
        }
      ],
      "advanced": true
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "default": "",
      "help": "Blank uses the place.",
      "advanced": true
    },
    {
      "name": "header",
      "type": "select",
      "label": "Title line",
      "default": "top",
      "choices": [
        {
          "value": "top",
          "label": "Above the page"
        },
        {
          "value": "bottom",
          "label": "Below the page"
        },
        {
          "value": "hidden",
          "label": "Hidden"
        }
      ],
      "advanced": true
    },
    {
      "name": "footer",
      "type": "select",
      "label": "Foot of the page",
      "default": "show",
      "choices": [
        {
          "value": "show",
          "label": "Status and credits"
        },
        {
          "value": "credits",
          "label": "Credits only"
        },
        {
          "value": "hide",
          "label": "Nothing"
        }
      ],
      "advanced": true
    },
    {
      "name": "panel",
      "type": "select",
      "label": "Panel",
      "default": "colour",
      "choices": [
        {
          "value": "colour",
          "label": "Colour"
        },
        {
          "value": "gray16",
          "label": "16 greys"
        },
        {
          "value": "gray4",
          "label": "4 greys"
        },
        {
          "value": "mono",
          "label": "Black and white"
        }
      ],
      "help": "What the panel can show. Pictures are converted and contrast-stretched to match.",
      "advanced": true
    },
    {
      "name": "text_size",
      "type": "select",
      "label": "Text size",
      "default": "100",
      "choices": [
        {
          "value": "60",
          "label": "60%"
        },
        {
          "value": "80",
          "label": "80%"
        },
        {
          "value": "100",
          "label": "100%"
        },
        {
          "value": "125",
          "label": "125%"
        },
        {
          "value": "150",
          "label": "150%"
        }
      ],
      "advanced": true
    },
    {
      "name": "font",
      "type": "select",
      "label": "Typeface",
      "default": "fell",
      "choices": [
        {
          "value": "fell",
          "label": "IM Fell English: the old plate"
        },
        {
          "value": "archivo",
          "label": "Archivo Narrow: clean and plain"
        },
        {
          "value": "georgia",
          "label": "Georgia: a modern serif"
        },
        {
          "value": "page",
          "label": "The dashboard's own font"
        }
      ],
      "advanced": true
    }
  ],
  "data_schema": {
    "fields": [
      {
        "name": "title",
        "type": "str",
        "label": "Title"
      },
      {
        "name": "within",
        "type": "num",
        "label": "Trains and trams within reach"
      },
      {
        "name": "vehicles",
        "type": "arr",
        "label": "Trains and trams shown"
      }
    ]
  }
}
